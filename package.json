{
  "name": "translate-meet",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "anahtar": "uv run --project apps/api python scripts/anahtar_ekle.py",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:api": "cd apps/api && uv run pytest",
    "test:gateway": "cd apps/gateway && uv run pytest",
    "lint:py": "cd apps/api && uv run ruff check . && cd ../gateway && uv run ruff check .",
    "dev:api": "cd apps/api && uv run uvicorn app.asgi:app --reload --port 8000",
    "dev:gateway": "cd apps/gateway && uv run uvicorn app.asgi:app --reload --port 8001",
    "dev:mobile": "pnpm --filter @translate-meet/mobile start"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": "^8.5.23"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-qr28-fpjm-wq7f",
        "GHSA-vcc3-ghjq-m6fr"
      ]
    }
  }
}
